# Copy this file to `.env` and fill in the key of the provider you use.
# `.env` is git-ignored and never copied into the Docker image (.dockerignore).
# GPTScan loads it at startup (python-dotenv). Under SmartBugs the same
# variables are forwarded from the host instead; see tools/gptscan/config.yaml
# in the SmartBugs repository.

# API keys. Only the key of the selected provider is required.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Provider: deepseek (default) | openai | custom (any OpenAI-compatible endpoint).
GPTSCAN_PROVIDER=deepseek

# Model id. Leave empty for the provider's default (src/config.py, PROVIDERS).
GPTSCAN_MODEL=

# Only for GPTSCAN_PROVIDER=custom: the endpoint URL and its key.
GPTSCAN_BASE_URL=
GPTSCAN_API_KEY=

# 1 = run the whole pipeline without a single LLM call (no cost); 0 = normal run.
GPTSCAN_DRY_RUN=0
